# ============================================
# LANDING PAGE ENVIRONMENT VARIABLES (EXAMPLE)
# ============================================
# Copy file ini menjadi .env dan sesuaikan dengan konfigurasi Anda

# Laravel SaaS Backend API URL
VITE_SAAS_URL=http://127.0.0.1:8000

# API Endpoints
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Authentication Endpoints
VITE_AUTH_LOGIN_URL=http://127.0.0.1:8000/login
VITE_AUTH_REGISTER_URL=http://127.0.0.1:8000/register
VITE_AUTH_DASHBOARD_URL=http://127.0.0.1:8000/dashboard

# App Configuration
VITE_APP_NAME=SILPD Landing Page
VITE_APP_URL=http://localhost:8080

# API Configuration
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# External Services (uncomment dan isi jika diperlukan)
# VITE_GOOGLE_ANALYTICS_ID=your-ga-id
# VITE_SENTRY_DSN=your-sentry-dsn
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-key
